{
  "name": "sales-companion-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:railway": "prisma generate --schema prisma/schema.postgresql.prisma && next build",
    "build:netlify": "prisma generate --schema prisma/schema.postgresql.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate:railway": "prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "db:migrate:postgres": "prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "db:studio": "prisma studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@netlify/database": "latest",
    "@prisma/client": "^6.19.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "openai": "^6.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  }
}
